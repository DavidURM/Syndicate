{
  "name": "@syndicate-lang/ws-relay",
  "version": "1.0.0-rc.2",
  "description": "Browser WebSocket relay to a Syndicate server",
  "author": "Tony Garnock-Jones <tonyg@leastfixedpoint.com>",
  "homepage": "https://git.syndicate-lang.org/syndicate-lang/syndicate-js/src/branch/main/packages/ws-relay",
  "license": "GPL-3.0+",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://git.syndicate-lang.org/syndicate-lang/syndicate-js"
  },
  "scripts": {
    "prepare": "yarn compile && yarn bundle",
    "compile": "syndicate-tsc",
    "compile:watch": "syndicate-tsc -w --verbose --intermediate-directory src.ts",
    "bundle": "tsup",
    "bundle:watch": "tsup --watch",
    "clean": "rm -rf lib/ dist/ index.js index.js.map",
    "veryclean": "yarn run clean && rm -rf node_modules"
  },
  "main": "dist/syndicate-ws-relay.cjs",
  "module": "dist/syndicate-ws-relay.mjs",
  "browser": "dist/syndicate-ws-relay.js",
  "types": "lib/index.d.ts",
  "exports": {
    "import": "./dist/syndicate-ws-relay.mjs",
    "require": "./dist/syndicate-ws-relay.cjs"
  },
  "peerDependencies": {
    "@preserves/core": "^1.0.0-rc.1"
  },
  "dependencies": {
    "@syndicate-lang/core": "^1.0.0-rc.1"
  },
  "devDependencies": {
    "@syndicate-lang/ts-plugin": "^1.0.0-rc.2",
    "@syndicate-lang/tsc": "^1.0.0-rc.2"
  },
  "gitHead": "3e17df1c9a88a3f53992932f9e18cb80ef35a3c1"
}
